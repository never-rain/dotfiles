{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "chafa",
    "source": "~/.config/wallpapers/16.png",
    "width": 93,
    "chafa": {
      "symbols": "vhalf"
    },
    "padding": {
      "left": 0,
      "right": 2
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "title": "#c6d0f5",
      "keys": "#81c8be",
    },
    "key": {
      "type": "both",
    },
    "percent": {
      "type": 9, // 1=number, 2=bar, 3=both, 9=colored number
      "color": {
        "green": "#a6d189",
        "yellow": "#e5c890",
        "red": "#e78284",
      },
    },
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors",
  ],
}
