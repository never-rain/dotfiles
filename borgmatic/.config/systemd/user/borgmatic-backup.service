[Unit]
Description=Back up home directory with borgmatic

[Service]
Type=oneshot
ExecStart=/usr/bin/borgmatic --config %h/.config/borgmatic/config.yaml --verbosity 1 create --stats
ExecStopPost=-/bin/sh %h/.local/libexec/borgmatic-notify
Environment="BORG_RSH=ssh -o BatchMode=yes -o ConnectTimeout=30"
TimeoutStartSec=infinity
TimeoutStopSec=60
Nice=10

